{
  "name": "nx-rust-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "nx-rust-e2e/src",
  "implicitDependencies": ["@convesoft/nx-rust"],
  "targets": {
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "...",
        "{workspaceRoot}/tools/scripts/**/*",
        "{workspaceRoot}/.verdaccio/**/*",
        "{workspaceRoot}/project.json"
      ],
      "options": {
        "runInBand": true
      }
    },
    "typecheck": {
      "command": "tsc --noEmit -p nx-rust-e2e/tsconfig.spec.json",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/jest.config.cts",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.spec.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/nx-rust/**/*.ts",
        "{workspaceRoot}/tools/scripts/*.d.ts",
        {
          "externalDependencies": [
            "typescript",
            "tslib",
            "@types/node",
            "@types/jest",
            "@nx/devkit",
            "nx"
          ]
        }
      ]
    },
    "lint": {
      "dependsOn": ["typecheck"]
    }
  }
}
