{
  "name": "nx-rust-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "nx-rust-e2e/src",
  "implicitDependencies": ["@convesoft/nx-rust"],
  "targets": {
    "e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "...",
        "{workspaceRoot}/tools/scripts/**/*",
        "{workspaceRoot}/.verdaccio/**/*",
        "{workspaceRoot}/project.json"
      ],
      "options": {
        "runInBand": true
      }
    }
  }
}
